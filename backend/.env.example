# ExecFlow — Backend Environment Variables

# Application
APP_NAME="ExecFlow Management Execution System"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Security & Authentication
SECRET_KEY="execflow-enterprise-production-jwt-key-32chars-min-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Local SQLite (Default):
DATABASE_URL="sqlite+aiosqlite:///./mes.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://execflow_user:password@localhost:5432/execflow_db"

# Google Calendar OAuth 2.0 Integration
# (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/calendar/oauth/callback"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins
# Add production domain when deploying (e.g., https://app.execflow.com)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]

# Email Notifications (SMTP - Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@company.com"
SMTP_PASSWORD="app-specific-password"
EMAIL_FROM="ExecFlow Notifications <noreply@company.com>"
